/* 商品详情 - 京东风格 */
.page {
  min-height: 100vh;
  background: var(--gray-bg);
  padding-bottom: 180rpx;
}

/* 商品图片 */
.img-section {
  width: 100%;
  height: 750rpx;
  background: #FFFFFF;
}

.main-img {
  width: 100%;
  height: 100%;
}

/* 价格信息 */
.info-card {
  margin: 20rpx;
  padding: 24rpx;
  background: var(--white);
  border-radius: 12rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
}

.main-price .price-sm { font-size: 28rpx; }
.main-price .price-lg { font-size: 52rpx; font-weight: 700; }

.discount-tag {
  padding: 4rpx 12rpx;
  background: var(--red);
  color: var(--white);
  font-size: 22rpx;
  border-radius: 4rpx;
}

.product-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--black);
  line-height: 1.5;
  margin-top: 16rpx;
}

.info-stats {
  display: flex;
  gap: 32rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5F5F5;
  font-size: 26rpx;
  color: var(--gray);
}

/* 详情 */
.detail-card {
  margin: 0 20rpx;
  padding: 24rpx;
  background: var(--white);
  border-radius: 12rpx;
}

.detail-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--black);
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
  margin-bottom: 16rpx;
}

.detail-text {
  font-size: 28rpx;
  color: var(--gray-dark);
  line-height: 1.8;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--white);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
}

.action-icons {
  display: flex;
  gap: 32rpx;
  margin-right: 24rpx;
}

.action-icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  font-size: 40rpx;
}

.action-icon-text {
  font-size: 20rpx;
  color: var(--gray);
  margin-top: 4rpx;
}

.action-btns {
  flex: 1;
  display: flex;
  height: 80rpx;
  border-radius: 40rpx;
  overflow: hidden;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--white);
}

.btn-cart {
  background: linear-gradient(90deg, #FFB347 0%, #FF9500 100%);
}

.btn-buy {
  background: linear-gradient(90deg, var(--red) 0%, var(--red-light) 100%);
}

/* 数量选择弹窗 */
.qty-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.qty-content {
  width: 100%;
  background: var(--white);
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.qty-header {
  display: flex;
  padding: 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
  position: relative;
}

.qty-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.qty-info {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.qty-info .price-symbol {
  font-size: 28rpx;
  color: var(--red);
}

.qty-info .price-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--red);
}

.qty-stock {
  font-size: 24rpx;
  color: var(--gray);
  margin-top: 8rpx;
}

.qty-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--gray);
}

.qty-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
}

.qty-label {
  font-size: 28rpx;
  color: var(--black);
}

.qty-ctrl {
  display: flex;
  align-items: center;
  background: var(--gray-bg);
  border-radius: 8rpx;
}

.qty-btn {
  width: 64rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--black);
}

.qty-btn.disabled { color: var(--gray-light); }

.qty-num {
  width: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.qty-footer {
  padding: 24rpx 32rpx;
}

.qty-confirm {
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--white);
}

/* 加载 */
.loading-page {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: var(--gray);
}
