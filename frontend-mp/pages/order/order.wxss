/* ==================== 确认订单页样式 ==================== */
.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 200rpx;
  background-color: #f7f8fa;
}

/* ==================== 区块样式 ==================== */
.section {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

/* ==================== 收货信息 ==================== */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #646566;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #323233;
}

.form-input::placeholder {
  color: #c8c9cc;
}

/* ==================== 商品列表 ==================== */
.goods-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background-color: #f7f8fa;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 28rpx;
  color: #323233;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-bottom {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-quantity {
  font-size: 26rpx;
  color: #969799;
}

/* ==================== 备注 ==================== */
.remark-input {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  padding: 0;
  line-height: 1.6;
}

.remark-input::placeholder {
  color: #c8c9cc;
}

/* ==================== 底部结算 ==================== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.total-info {
  display: flex;
  align-items: baseline;
  margin-right: 32rpx;
  font-size: 28rpx;
  color: #646566;
}

.total-info .price-integer {
  font-size: 44rpx;
}

.submit-btn {
  min-width: 240rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255, 77, 79, 0.35);
}

.submit-btn.disabled {
  background: #e8e8e8;
  color: #c8c9cc;
  box-shadow: none;
}


/* ==================== 地址选择 ==================== */
.address-section {
  position: relative;
}

.address-section .section-title {
  margin-bottom: 20rpx;
}

.address-content {
  display: flex;
  align-items: center;
}

.address-info {
  flex: 1;
}

.address-user {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-right: 16rpx;
}

.user-phone {
  font-size: 28rpx;
  color: #646566;
}

.address-detail {
  font-size: 28rpx;
  color: #646566;
  line-height: 1.5;
}

.address-empty {
  display: flex;
  align-items: center;
  flex: 1;
}

.empty-text {
  font-size: 28rpx;
  color: #c8c9cc;
}

.address-arrow {
  font-size: 32rpx;
  color: #c8c9cc;
  margin-left: 16rpx;
}

/* ==================== 地址选择弹窗 ==================== */
.address-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.address-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.address-picker {
  position: relative;
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  z-index: 1;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  flex-shrink: 0;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.picker-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.picker-body {
  flex: 1;
  max-height: 50vh;
}

.picker-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.picker-item.active {
  background: #fff5f5;
}

.picker-radio {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  margin-right: 20rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-item.active .picker-radio {
  border-color: #ff4d4f;
}

.radio-inner {
  width: 24rpx;
  height: 24rpx;
  background: #ff4d4f;
  border-radius: 50%;
}

.picker-info {
  flex: 1;
}

.picker-user {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.picker-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-right: 16rpx;
}

.picker-phone {
  font-size: 26rpx;
  color: #646566;
}

.picker-tag {
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  border-radius: 4rpx;
}

.picker-detail {
  font-size: 26rpx;
  color: #646566;
  line-height: 1.5;
}

.picker-empty {
  padding: 60rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.picker-footer {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f5f5f5;
  flex-shrink: 0;
}

.picker-add {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}
