.page {
  min-height: 100vh;
  background: var(--gray-bg);
}

/* 搜索栏 */
.search-header {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--white);
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: var(--gray-bg);
  border-radius: 36rpx;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.clear-btn {
  font-size: 36rpx;
  color: var(--gray);
  padding: 0 8rpx;
}

.cancel-btn {
  font-size: 28rpx;
  color: var(--black);
  padding-left: 24rpx;
}

/* 区块 */
.history-section, .hot-section {
  margin: 24rpx;
  padding: 24rpx;
  background: var(--white);
  border-radius: var(--radius);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--black);
}

.clear-history {
  font-size: 24rpx;
  color: var(--gray);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 12rpx 24rpx;
  background: var(--gray-bg);
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--gray-dark);
}

.tag.hot {
  background: #FFF5F5;
  color: var(--red);
}

/* 结果 */
.result-section {
  padding: 24rpx;
}

.result-count {
  font-size: 26rpx;
  color: var(--gray);
  margin-bottom: 20rpx;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.product-item {
  display: flex;
  padding: 20rpx;
  background: var(--white);
  border-radius: var(--radius);
}

.product-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--black);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-desc {
  font-size: 24rpx;
  color: var(--gray);
  margin-top: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-wrap {
  display: flex;
  align-items: baseline;
}

.sales {
  font-size: 22rpx;
  color: var(--gray);
}

/* 状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.3;
  margin-bottom: 20rpx;
}

.empty-text {
  color: var(--gray);
}

.loading, .no-more {
  text-align: center;
  padding: 32rpx;
  color: var(--gray);
  font-size: 26rpx;
}
