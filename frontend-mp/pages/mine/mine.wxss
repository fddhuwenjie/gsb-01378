/* 个人中心 - 京东风格 */
.page {
  min-height: 100vh;
  background: var(--gray-bg);
}

/* 头部 */
.header {
  padding: 60rpx 32rpx 80rpx;
  background: linear-gradient(135deg, var(--red) 0%, #FF6B6B 100%);
}

.user-box {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.3);
}

.user-info {
  margin-left: 24rpx;
}

.nickname {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--white);
}

.uid {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

.login-text {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--white);
  margin-left: 24rpx;
}

/* 订单卡片 */
.order-card {
  margin: -40rpx 20rpx 20rpx;
  padding: 24rpx;
  background: var(--white);
  border-radius: 12rpx;
  position: relative;
  z-index: 10;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--black);
}

.card-more {
  font-size: 24rpx;
  color: var(--gray);
}

.order-grid {
  display: flex;
  padding-top: 24rpx;
}

.order-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.order-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.order-text {
  font-size: 24rpx;
  color: var(--gray-dark);
}

/* 菜单 */
.menu-card {
  margin: 0 20rpx 20rpx;
  background: var(--white);
  border-radius: 12rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item:last-child {
  border-bottom: none;
}

/* 联系客服按钮 */
.contact-item {
  position: relative;
}

.contact-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  padding: 0;
  margin: 0;
}

.contact-btn::after {
  border: none;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--black);
}

.menu-arrow {
  font-size: 26rpx;
  color: var(--gray-light);
}

/* 退出 */
.logout-btn {
  margin: 40rpx 20rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--white);
  border-radius: 44rpx;
  color: var(--red);
  font-size: 30rpx;
}
