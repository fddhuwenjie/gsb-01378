<view class="page">
  <!-- 头部 -->
  <view class="header">
    <view class="header-bg bg-1"></view>
    <view class="header-bg bg-2"></view>
    
    <view class="user-box" wx:if="{{userInfo}}">
      <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" />
      <view class="user-info">
        <text class="nickname">{{userInfo.nickname || '用户'}}</text>
        <text class="uid">ID: {{userInfo.id}}</text>
      </view>
    </view>
    
    <view class="user-box" wx:else bindtap="login">
      <image class="avatar" src="/images/default-avatar.png" />
      <text class="login-text">点击登录</text>
    </view>
  </view>

  <!-- 订单卡片 -->
  <view class="order-card">
    <view class="card-head" bindtap="goOrders">
      <text class="card-title">我的订单</text>
      <view class="card-more">
        <text>全部订单</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="order-grid">
      <view class="order-item" bindtap="goOrders" data-status="pending">
        <view class="order-icon-wrap">
          <text class="order-icon">💳</text>
        </view>
        <text class="order-text">待付款</text>
      </view>
      <view class="order-item" bindtap="goOrders" data-status="paid">
        <view class="order-icon-wrap">
          <text class="order-icon">📦</text>
        </view>
        <text class="order-text">待发货</text>
      </view>
      <view class="order-item" bindtap="goOrders" data-status="shipped">
        <view class="order-icon-wrap">
          <text class="order-icon">🚚</text>
        </view>
        <text class="order-text">待收货</text>
      </view>
      <view class="order-item" bindtap="goOrders" data-status="completed">
        <view class="order-icon-wrap">
          <text class="order-icon">✅</text>
        </view>
        <text class="order-text">已完成</text>
      </view>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="goAddress">
      <view class="menu-icon-wrap">
        <text class="menu-icon">📍</text>
      </view>
      <text class="menu-text">收货地址</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item contact-item">
      <view class="menu-icon-wrap">
        <text class="menu-icon">💬</text>
      </view>
      <text class="menu-text">联系客服</text>
      <text class="menu-arrow">›</text>
      <button class="contact-btn" open-type="contact"></button>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-btn" wx:if="{{userInfo}}" bindtap="logout">
    退出登录
  </view>
</view>
