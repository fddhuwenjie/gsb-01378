<view class="page">
  <view class="status-bar" wx:if="{{order && order.status === 'pending'}}">
    <view class="countdown-section">
      <view class="countdown-label">剩余支付时间</view>
      <view class="countdown-time {{remainingSeconds < 300 ? 'urgent' : ''}}">
        <text class="time-num">{{minutes}}</text>
        <text class="time-sep">:</text>
        <text class="time-num">{{seconds}}</text>
      </view>
      <view class="countdown-tip">{{remainingSeconds > 0 ? '请在规定时间内完成支付' : '订单已超时关闭'}}</view>
    </view>
  </view>

  <view class="status-bar timeout" wx:elif="{{order && (order.status === 'timeout' || isExpired)}}">
    <view class="timeout-icon">⏰</view>
    <view class="timeout-text">订单已超时关闭</view>
    <view class="timeout-desc">库存已释放，请重新下单</view>
  </view>

  <view class="status-bar paid" wx:elif="{{order && order.status === 'paid'}}">
    <view class="paid-icon">✅</view>
    <view class="paid-text">支付成功</view>
  </view>

  <view class="status-bar cancelled" wx:elif="{{order && order.status === 'cancelled'}}">
    <view class="cancelled-icon">❌</view>
    <view class="cancelled-text">订单已取消</view>
  </view>

  <view class="section" wx:if="{{order}}">
    <view class="section-title">订单信息</view>
    <view class="order-info">
      <view class="info-row">
        <text class="info-label">订单号</text>
        <text class="info-value">{{order.order_no}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{order.created_at}}</text>
      </view>
      <view class="info-row" wx:if="{{order.pay_expire_time_formatted}}">
        <text class="info-label">支付截止</text>
        <text class="info-value">{{order.pay_expire_time_formatted}}</text>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{order && order.items}}">
    <view class="section-title">商品信息</view>
    <view class="goods-item" wx:for="{{order.items}}" wx:key="id">
      <image class="goods-image" src="{{item.product_image}}" mode="aspectFill" />
      <view class="goods-info">
        <text class="goods-name">{{item.product_name}}</text>
        <view class="goods-bottom">
          <view class="price">
            <text class="price-symbol">¥</text>
            <text class="price-value">{{item.price}}</text>
          </view>
          <text class="goods-quantity">×{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="total-info">
      <text>实付金额：</text>
      <view class="price big">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{order ? order.total_amount : '0.00'}}</text>
      </view>
    </view>
    <block wx:if="{{order && order.status === 'pending' && remainingSeconds > 0}}">
      <view class="action-btn outline" bindtap="cancelOrder">取消订单</view>
      <view class="action-btn primary {{paying ? 'disabled' : ''}}" bindtap="goToPay">
        {{paying ? '支付中...' : '立即支付'}}
      </view>
    </block>
    <block wx:elif="{{order && (order.status === 'timeout' || order.status === 'cancelled' || isExpired)}}">
      <view class="action-btn primary full" bindtap="goBack">返回订单列表</view>
    </block>
    <block wx:elif="{{order && order.status === 'paid'}}">
      <view class="action-btn primary full" bindtap="goToOrderList">查看订单</view>
    </block>
  </view>
</view>
