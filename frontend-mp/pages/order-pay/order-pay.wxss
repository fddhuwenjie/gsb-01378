.page {
  padding-bottom: 120rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.status-bar {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
  padding: 60rpx 30rpx;
  text-align: center;
  color: white;
}

.status-bar.timeout {
  background: linear-gradient(135deg, #636e72 0%, #2d3436 100%);
}

.status-bar.paid {
  background: linear-gradient(135deg, #00b894 0%, #00a085 100%);
}

.status-bar.cancelled {
  background: linear-gradient(135deg, #b2bec3 0%, #636e72 100%);
}

.countdown-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.countdown-label {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
}

.countdown-time {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.countdown-time.urgent {
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.time-num {
  background: rgba(255,255,255,0.25);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 56rpx;
  font-weight: bold;
  min-width: 80rpx;
  text-align: center;
}

.time-sep {
  font-size: 48rpx;
  font-weight: bold;
  margin: 0 12rpx;
}

.countdown-tip {
  font-size: 24rpx;
  opacity: 0.8;
}

.timeout-icon, .paid-icon, .cancelled-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.timeout-text, .paid-text, .cancelled-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.timeout-desc {
  font-size: 26rpx;
  opacity: 0.8;
}

.section {
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-info {
  font-size: 28rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.info-label {
  color: #999;
}

.info-value {
  color: #333;
}

.goods-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price {
  color: #e93b3d;
  font-size: 28rpx;
}

.price.big {
  font-size: 40rpx;
  font-weight: bold;
}

.price-symbol {
  font-size: 0.8em;
}

.goods-quantity {
  color: #999;
  font-size: 26rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.total-info {
  flex: 1;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.action-btn {
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  margin-left: 20rpx;
  text-align: center;
}

.action-btn.outline {
  border: 2rpx solid #ddd;
  color: #666;
  background: white;
}

.action-btn.primary {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
  color: white;
}

.action-btn.primary.full {
  flex: 1;
  margin-left: 0;
}

.action-btn.disabled {
  opacity: 0.6;
}
