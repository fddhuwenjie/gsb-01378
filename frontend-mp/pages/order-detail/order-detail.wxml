<view class="page">
  <view class="status-tabs">
    <view 
      class="tab-item {{currentStatus === item.value ? 'active' : ''}}" 
      wx:for="{{statusTabs}}" 
      wx:key="value"
      bindtap="switchTab"
      data-status="{{item.value}}"
    >
      {{item.label}}
    </view>
  </view>

  <view class="order-list">
    <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="goToOrderDetail" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-no">订单号：{{item.order_no}}</text>
        <text class="order-status status-{{item.status}}">
          {{item.statusText}}
        </text>
      </view>

      <view class="countdown-bar" wx:if="{{item.status === 'pending' && countdowns[item.id] > 0}}">
        <text class="countdown-icon">⏰</text>
        <text class="countdown-text">剩余支付时间：</text>
        <text class="countdown-time {{countdowns[item.id] < 300 ? 'urgent' : ''}}">{{countdowns[item.id] >= 60 ? (Math.floor(countdowns[item.id]/60) + '分' + (countdowns[item.id]%60) + '秒') : countdowns[item.id] + '秒'}}</text>
      </view>

      <view class="timeout-bar" wx:if="{{item.status === 'pending' && item.is_expired}}">
        <text class="timeout-icon">⚠️</text>
        <text class="timeout-text">订单即将超时关闭</text>
      </view>

      <view class="timeout-bar" wx:if="{{item.status === 'timeout'}}">
        <text class="timeout-icon">⌛</text>
        <text class="timeout-text">订单已超时关闭，库存已释放</text>
      </view>
      
      <view class="order-items">
        <view class="order-item" wx:for="{{item.items}}" wx:for-item="product" wx:key="id" catchtap="">
          <image class="item-image" src="{{product.product_image}}" mode="aspectFill" />
          <view class="item-info">
            <text class="item-name">{{product.product_name}}</text>
            <view class="item-bottom">
              <text class="item-price">¥{{product.price}}</text>
              <text class="item-quantity">×{{product.quantity}}</text>
            </view>
          </view>
        </view>
      </view>
      
      <view class="order-footer">
        <view class="order-total">
          <text>共 {{item.items.length}} 件商品，合计：</text>
          <text class="total-price">¥{{item.total_amount}}</text>
        </view>
        <view class="order-actions" wx:if="{{item.status === 'pending' && !item.is_expired}}">
          <view class="action-btn outline" catchtap="cancelOrder" data-id="{{item.id}}">取消订单</view>
          <view class="action-btn primary" catchtap="goToPay" data-id="{{item.id}}">去支付</view>
        </view>
        <view class="order-actions" wx:elif="{{item.status === 'timeout' || item.status === 'cancelled'}}">
          <view class="action-btn outline" catchtap="">已关闭</view>
        </view>
      </view>
    </view>
  </view>

  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  <view class="no-more" wx:if="{{!hasMore && orders.length > 0}}">
    <text>没有更多了</text>
  </view>
  
  <view class="empty" wx:if="{{!loading && orders.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
  </view>
</view>
