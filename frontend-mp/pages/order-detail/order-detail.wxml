<view class="page">
  <view wx:if="{{loading}}" class="loading-container">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{order}}" class="order-detail">
    <view class="status-header status-{{order.status}}">
      <view class="status-icon">
        <text wx:if="{{order.status === 'pending'}}">⏳</text>
        <text wx:elif="{{order.status === 'paid'}}">✅</text>
        <text wx:elif="{{order.status === 'shipped'}}">🚚</text>
        <text wx:elif="{{order.status === 'completed'}}">🎉</text>
        <text wx:elif="{{order.status === 'cancelled'}}">❌</text>
        <text wx:elif="{{order.status === 'timeout'}}">⏰</text>
      </view>
      <view class="status-text">{{order.status === 'pending' ? '等待付款' : order.status === 'paid' ? '付款成功' : order.status === 'shipped' ? '已发货' : order.status === 'completed' ? '交易完成' : order.status === 'timeout' ? '订单已超时' : '订单已取消'}}</view>
      
      <view wx:if="{{order.status === 'pending' && !order.pay_expired}}" class="countdown-banner">
        <view class="countdown-label">请在以下时间内完成支付</view>
        <view class="countdown-time">{{order.countdown_text}}</view>
        <view class="countdown-tip">超时后订单将自动关闭，库存将释放</view>
      </view>

      <view wx:if="{{order.status === 'pending' && order.pay_expired}}" class="timeout-banner">
        <view class="timeout-text">订单已超时关闭</view>
        <view class="timeout-tip">预占库存已自动释放</view>
      </view>

      <view wx:if="{{order.status === 'timeout'}}" class="timeout-banner">
        <view class="timeout-text">订单已超时关闭</view>
        <view class="timeout-tip">预占库存已自动释放</view>
      </view>
    </view>

    <view class="section address-section">
      <view class="section-title">收货信息</view>
      <view class="address-info">
        <view class="address-user">{{order.receiver_name}} <text class="phone">{{order.receiver_phone}}</text></view>
        <view class="address-detail">{{order.address}}</view>
      </view>
    </view>

    <view class="section goods-section">
      <view class="section-title">商品信息</view>
      <view class="goods-list">
        <view class="goods-item" wx:for="{{order.items}}" wx:key="id">
          <image class="goods-image" src="{{item.product_image}}" mode="aspectFill" />
          <view class="goods-info">
            <view class="goods-name">{{item.product_name}}</view>
            <view class="goods-bottom">
              <text class="goods-price">¥{{item.price}}</text>
              <text class="goods-quantity">×{{item.quantity}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="section remark-section" wx:if="{{order.remark}}">
      <view class="section-title">订单备注</view>
      <view class="remark-text">{{order.remark}}</view>
    </view>

    <view class="section info-section">
      <view class="section-title">订单信息</view>
      <view class="info-row">
        <text class="info-label">订单编号</text>
        <text class="info-value">{{order.order_no}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{order.created_at}}</text>
      </view>
      <view class="info-row" wx:if="{{order.pay_expire_time && order.status === 'pending'}}">
        <text class="info-label">支付截止</text>
        <text class="info-value">{{order.pay_expire_time}}</text>
      </view>
      <view class="info-row" wx:if="{{order.paid_at}}">
        <text class="info-label">支付时间</text>
        <text class="info-value">{{order.paid_at}}</text>
      </view>
      <view class="info-row total-row">
        <text class="info-label">订单金额</text>
        <text class="info-value total-amount">¥{{order.total_amount}}</text>
      </view>
    </view>

    <view class="footer-actions">
      <view wx:if="{{order.status === 'pending' && !order.pay_expired}}" class="action-group">
        <view class="action-btn outline" bindtap="cancelOrder">取消订单</view>
        <view class="action-btn primary" bindtap="goToPay">立即支付</view>
      </view>

      <view wx:if="{{order.status === 'pending' && order.pay_expired}}" class="action-group">
        <view class="action-btn outline" bindtap="goBack">返回</view>
        <view class="action-btn primary" bindtap="goToHome">重新选购</view>
      </view>

      <view wx:if="{{order.status === 'timeout' || order.status === 'cancelled'}}" class="action-group">
        <view class="action-btn outline" bindtap="goBack">返回</view>
        <view class="action-btn primary" bindtap="goToHome">重新选购</view>
      </view>

      <view wx:if="{{order.status === 'paid' || order.status === 'shipped' || order.status === 'completed'}}" class="action-group">
        <view class="action-btn outline" bindtap="goBack">返回订单列表</view>
      </view>
    </view>
  </view>
</view>
