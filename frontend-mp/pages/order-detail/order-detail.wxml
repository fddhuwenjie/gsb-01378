<view class="page">
  <!-- 状态标签页 -->
  <view class="status-tabs">
    <view 
      class="tab-item {{currentStatus === item.value ? 'active' : ''}}" 
      wx:for="{{statusTabs}}" 
      wx:key="value"
      bindtap="switchTab"
      data-status="{{item.value}}"
    >
      {{item.label}}
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list">
    <view class="order-card" wx:for="{{orders}}" wx:key="id">
      <view class="order-header">
        <text class="order-no">订单号：{{item.order_no}}</text>
        <text class="order-status status-{{item.status}}">
          {{item.status === 'pending' ? '待付款' : item.status === 'paid' ? '待发货' : item.status === 'shipped' ? '待收货' : item.status === 'completed' ? '已完成' : item.status === 'closed' ? '超时关闭' : '已取消'}}
        </text>
      </view>

      <!-- 待付款订单的支付倒计时；过期后展示明确提示，告知库存已释放 -->
      <view class="countdown-bar" wx:if="{{item.status === 'pending'}}">
        <block wx:if="{{item.pay_expired}}">
          <text class="countdown-expired">⏰ 已过期，库存已释放，请重新下单</text>
        </block>
        <block wx:else>
          <text class="countdown-label">剩余支付时间</text>
          <text class="countdown-value">{{item.remaining_text}}</text>
        </block>
      </view>
      
      <view class="order-items">
        <view class="order-item" wx:for="{{item.items}}" wx:for-item="product" wx:key="id">
          <image class="item-image" src="{{product.product_image}}" mode="aspectFill" />
          <view class="item-info">
            <text class="item-name">{{product.product_name}}</text>
            <view class="item-bottom">
              <text class="item-price">¥{{product.price}}</text>
              <text class="item-quantity">×{{product.quantity}}</text>
            </view>
          </view>
        </view>
      </view>
      
      <view class="order-footer">
        <view class="order-total">
          <text>共 {{item.items.length}} 件商品，合计：</text>
          <text class="total-price">¥{{item.total_amount}}</text>
        </view>
        <view class="order-actions" wx:if="{{item.status === 'pending'}}">
          <view class="action-btn outline" bindtap="cancelOrder" data-id="{{item.id}}">取消订单</view>
          <view class="action-btn primary {{item.pay_expired ? 'disabled' : ''}}" bindtap="goToPay" data-id="{{item.id}}">
            {{item.pay_expired ? '已过期' : '去支付'}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  <view class="no-more" wx:if="{{!hasMore && orders.length > 0}}">
    <text>没有更多了</text>
  </view>
  
  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && orders.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
  </view>
</view>
