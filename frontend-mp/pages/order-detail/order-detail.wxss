/* ==================== 订单列表页样式 ==================== */
.page {
  min-height: 100vh;
  background-color: #f7f8fa;
}

/* ==================== 状态标签页 ==================== */
.status-tabs {
  display: flex;
  background-color: #ffffff;
  padding: 0;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 32rpx 0;
  font-size: 28rpx;
  color: #646566;
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: #ff4d4f;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #ff4d4f 0%, #ff7875 100%);
  border-radius: 3rpx;
}

/* ==================== 订单列表 ==================== */
.order-list {
  padding: 24rpx;
}

.order-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-no {
  font-size: 24rpx;
  color: #969799;
}

.order-status {
  font-size: 26rpx;
  font-weight: 600;
}

.status-pending { color: #ff4d4f; }
.status-paid, .status-shipped { color: #1890ff; }
.status-completed { color: #52c41a; }
.status-cancelled, .status-timeout { color: #969799; }

/* ==================== 倒计时栏 ==================== */
.countdown-bar {
  padding: 16rpx 28rpx;
  background: linear-gradient(90deg, #fff7e6 0%, #fff1f0 100%);
}

.countdown-active {
  display: flex;
  align-items: center;
}

.countdown-label {
  font-size: 24rpx;
  color: #fa8c16;
}

.countdown-time {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 600;
  font-family: -apple-system, monospace;
}

.countdown-expired {
  font-size: 24rpx;
  color: #969799;
}

.action-btn.outline.disabled {
  opacity: 0.5;
  background-color: #f5f5f5;
}

/* ==================== 订单商品 ==================== */
.order-items {
  padding: 20rpx 28rpx;
}

.order-item {
  display: flex;
  margin-bottom: 20rpx;
}

.order-item:last-child {
  margin-bottom: 0;
}

.item-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background-color: #f7f8fa;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 28rpx;
  color: #323233;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.item-bottom {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-price {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 600;
}

.item-quantity {
  font-size: 26rpx;
  color: #969799;
}

/* ==================== 订单底部 ==================== */
.order-footer {
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #f5f5f5;
}

.order-total {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  font-size: 26rpx;
  color: #646566;
  margin-bottom: 20rpx;
}

.total-price {
  font-size: 34rpx;
  color: #ff4d4f;
  font-weight: 700;
  margin-left: 8rpx;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

.action-btn {
  padding: 16rpx 36rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.action-btn.outline {
  border: 2rpx solid #dcdee0;
  color: #646566;
  background-color: #ffffff;
}

.action-btn.outline:active {
  background-color: #f7f8fa;
}

.action-btn.primary {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3);
}

.action-btn.primary:active {
  transform: scale(0.96);
}

/* ==================== 加载状态 ==================== */
.loading-more, .no-more {
  text-align: center;
  padding: 32rpx;
  color: #c8c9cc;
  font-size: 24rpx;
}

/* ==================== 空状态 ==================== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  color: #969799;
  font-size: 28rpx;
}
