.page {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: 140rpx;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-top: 200rpx;
  color: #969799;
  font-size: 28rpx;
}

.order-detail {
  padding-bottom: 20rpx;
}

.status-header {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  padding: 60rpx 40rpx 40rpx;
  color: #ffffff;
}

.status-header.status-paid,
.status-header.status-shipped {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
}

.status-header.status-completed {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
}

.status-header.status-cancelled,
.status-header.status-timeout {
  background: linear-gradient(135deg, #8c8c8c 0%, #bfbfbf 100%);
}

.status-icon {
  font-size: 80rpx;
  text-align: center;
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.countdown-banner {
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}

.countdown-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.countdown-time {
  font-size: 56rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', 'Menlo', monospace;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.countdown-tip {
  font-size: 22rpx;
  opacity: 0.8;
}

.timeout-banner {
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
}

.timeout-text {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.timeout-tip {
  font-size: 24rpx;
  opacity: 0.9;
}

.section {
  background-color: #ffffff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #ff4d4f;
}

.address-info {
  padding: 0 8rpx;
}

.address-user {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 12rpx;
}

.address-user .phone {
  margin-left: 24rpx;
  font-weight: 400;
  color: #646566;
}

.address-detail {
  font-size: 26rpx;
  color: #646566;
  line-height: 1.6;
}

.goods-list {
  padding: 0 8rpx;
}

.goods-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background-color: #f7f8fa;
}

.goods-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 28rpx;
  color: #323233;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-bottom {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-price {
  font-size: 30rpx;
  color: #ff4d4f;
  font-weight: 600;
}

.goods-quantity {
  font-size: 26rpx;
  color: #969799;
}

.remark-text {
  font-size: 26rpx;
  color: #646566;
  padding: 0 8rpx;
  line-height: 1.6;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx;
  font-size: 26rpx;
}

.info-label {
  color: #969799;
}

.info-value {
  color: #323233;
}

.total-row {
  padding-top: 24rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.total-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff4d4f;
}

.footer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.action-group {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}

.action-btn {
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn.outline {
  border: 2rpx solid #dcdee0;
  color: #646566;
  background-color: #ffffff;
}

.action-btn.primary {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3);
}

.action-btn.primary:active {
  opacity: 0.9;
}

.action-btn.outline:active {
  background-color: #f7f8fa;
}
