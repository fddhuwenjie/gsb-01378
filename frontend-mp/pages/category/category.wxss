/* 分类页 - 京东风格 */
.page {
  display: flex;
  height: 100vh;
  background: var(--gray-bg);
}

/* 左侧导航 */
.cate-nav {
  width: 180rpx;
  height: 100%;
  background: #F7F7F7;
  flex-shrink: 0;
}

.cate-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx;
  position: relative;
}

.cate-item.active {
  background: var(--white);
}

.cate-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 40rpx;
  background: var(--red);
  border-radius: 0 6rpx 6rpx 0;
}

.cate-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.cate-name {
  font-size: 24rpx;
  color: var(--gray-dark);
  text-align: center;
}

.cate-item.active .cate-name {
  color: var(--red);
  font-weight: 600;
}

/* 右侧商品 */
.goods-area {
  flex: 1;
  height: 100%;
  background: var(--white);
}

.goods-item {
  display: flex;
  padding: 20rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.goods-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 28rpx;
  color: var(--black);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-desc {
  font-size: 24rpx;
  color: var(--gray);
  margin-top: 8rpx;
}

.goods-row {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.add-cart-btn {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, var(--red) 0%, var(--red-light) 100%);
  color: var(--white);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 300;
}

.goods-sales {
  font-size: 22rpx;
  color: var(--gray);
}

/* 状态 */
.status-bar {
  text-align: center;
  padding: 32rpx;
  color: var(--gray);
  font-size: 26rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.3;
  margin-bottom: 20rpx;
}

.empty-text {
  color: var(--gray);
}
